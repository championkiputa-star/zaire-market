# Normalisation des fins de ligne pour cross-platform
* text=auto

# Fichiers texte explicitement LF (Linux/Docker/Render)
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md  text eol=lf
*.sh  text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.htaccess text eol=lf
Dockerfile text eol=lf

# Fichiers binaires (ne pas toucher)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.apk binary
*.aab binary
